#!/usr/bin/env bash
# claude-accounts: use several Claude Code accounts on one machine, chosen by directory.
# Requires bash 3.2+, jq and mise. See README.md.
# shellcheck disable=SC2016  # jq programs are single-quoted on purpose
set -euo pipefail

# Find our own checkout through symlinks (macOS has no readlink -f)
src="$0"
while [ -L "$src" ]; do
  dir="$(cd "$(dirname "$src")" && pwd -P)"
  src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
ROOT="$(cd "$(dirname "$src")/.." && pwd -P)"
LIB="$ROOT/plugin/account-badge/scripts"
RESOLVE="$LIB/resolve"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/claude-accounts"
CONFIG="$CONFIG_DIR/accounts.json"
STATE="$CONFIG_DIR/state.json"
PLUGIN_ID="account-badge@account-switcher"
# Where apply installs the plugin from: a git checkout is its own marketplace. An installed package
# lives in a versioned directory that an upgrade removes, so it uses the GitHub repository instead.
GITHUB_REPO="zdavison/claude-accounts"
if [ -e "$ROOT/.git" ]; then DEFAULT_MARKETPLACE="$ROOT"; else DEFAULT_MARKETPLACE="$GITHUB_REPO"; fi
MIN_CLAUDE="2.1.289"
# Zed's command names (Arch installs it as zeditor); the tests replace them
EDITORS="${CLAUDE_ACCOUNTS_EDITORS:-zed zeditor}"

die() { printf 'claude-accounts: %s\n' "$*" >&2; exit 1; }

need() {
  local t
  for t in "$@"; do command -v "$t" >/dev/null 2>&1 || die "$t is not installed"; done
}

# jq with lib.jq available through: include "lib";
jql() { jq -L "$LIB" "$@"; }

load_config() {
  [ -f "$CONFIG" ] || die "no config at $CONFIG; run: claude-accounts init"
  jq -e . "$CONFIG" >/dev/null 2>&1 || die "invalid JSON in $CONFIG"
}

# Problems that make a config unusable (see lib.jq), one per line; nothing when it is fine
CHECK='include "lib"; problems'

# update_config JQ-ARGS... FILTER: rewrite the config, refusing a result that has problems
update_config() {
  local tmp="$CONFIG.tmp" problems
  jql "$@" "$CONFIG" > "$tmp" || { rm -f "$tmp"; die "could not update $CONFIG"; }
  problems="$(jql -r "$CHECK" "$tmp")" || { rm -f "$tmp"; die "could not check $CONFIG"; }
  if [ -n "$problems" ]; then rm -f "$tmp"; die "$problems"; fi
  mv "$tmp" "$CONFIG"
}

account_exists() { jq -e --arg n "$1" '.accounts | has($n)' "$CONFIG" >/dev/null; }

valid_name() {
  case "$1" in
    ''|-*|*[!abcdefghijklmnopqrstuvwxyz0123456789-]*) die "account names use lowercase letters, digits and -: '$1'" ;;
  esac
}

# Store paths absolute and real (., .. and symlinks resolved, so they match the physical
# directories Claude Code reports), with $HOME written as ~ so the config reads the same on every
# machine. Call it as an assignment, so a failure stops the script.
# shellcheck disable=SC2088  # the literal ~ is what gets stored
store_path() {
  local p
  p="$(expand_path "$1")"
  if [ -d "$p" ]; then
    p="$(cd "$p" && pwd -P)"
  else
    case "/$p/" in */./*|*/../*) die "$1 does not exist, so it can't contain . or .." ;; esac
  fi
  case "$p" in "$HOME") p="~" ;; "$HOME"/*) p="~/${p#"$HOME"/}" ;; esac
  [ "$p" = "/" ] || p="${p%/}"
  printf '%s' "$p"
}

# expand_path PATH: ~ expanded and made absolute, nothing resolved
# shellcheck disable=SC2088  # matching a literal ~ typed by the user
expand_path() {
  case "$1" in "~") printf '%s' "$HOME" ;; "~/"*) printf '%s' "$HOME/${1#"~/"}" ;; /*) printf '%s' "$1" ;; *) printf '%s' "$PWD/$1" ;; esac
}

# signed_in CONFIGDIR: true when that account has signed in (~/.claude keeps its state in ~/.claude.json)
signed_in() {
  local state="$1/.claude.json"
  [ "$1" != "$HOME/.claude" ] || state="$HOME/.claude.json"
  jq -e '.oauthAccount.emailAddress' "$state" >/dev/null 2>&1
}

# claude_as CONFIGDIR ARGS...: run claude as an account; ~/.claude means CLAUDE_CONFIG_DIR unset
claude_as() {
  local cdir="$1"
  shift
  if [ "$cdir" = "$HOME/.claude" ]; then
    env -u CLAUDE_CONFIG_DIR claude "$@"
  else
    env CLAUDE_CONFIG_DIR="$cdir" claude "$@"
  fi
}

plugin_installed() {
  claude_as "$1" plugin list --json 2>/dev/null \
    | jq -e --arg id "$PLUGIN_ID" 'any(.[]; .id == $id and .enabled)' >/dev/null 2>&1
}

# Undo CLAUDE_CONFIG_DIR in dirs an earlier apply set up that the config no longer lists,
# then record the dirs the config lists now
cleanup_stale() {
  local dir
  if [ -f "$STATE" ]; then
    while IFS= read -r dir <&3; do
      [ -f "$dir/mise.local.toml" ] || continue
      mise unset --file "$dir/mise.local.toml" CLAUDE_CONFIG_DIR >/dev/null || die "mise unset failed in $dir"
      echo "✔ $dir no longer sets CLAUDE_CONFIG_DIR"
    done 3< <(jql -r --slurpfile cfg "$CONFIG" 'include "lib";
      [$cfg[0] | accounts[] | .dirs[]] as $now
      | (.managedDirs // [])[] | select(. as $d | any($now[]; . == $d) | not)' "$STATE")
  fi
  mkdir -p "$CONFIG_DIR"
  jql 'include "lib"; {managedDirs: [accounts[] | .dirs[]]}' "$CONFIG" > "$STATE.tmp"
  mv "$STATE.tmp" "$STATE"
}

cmd_apply() {
  local source="${CLAUDE_ACCOUNTS_MARKETPLACE:-$DEFAULT_MARKETPLACE}" problems name cdir dir
  while [ $# -gt 0 ]; do
    case "$1" in
      --marketplace) [ $# -ge 2 ] || die "--marketplace needs a value"; source="$2"; shift 2 ;;
      *) die "unknown option: $1" ;;
    esac
  done
  need mise claude
  load_config
  problems="$(jql -r "$CHECK" "$CONFIG")"
  [ -z "$problems" ] || die "$problems"

  while IFS=$'\t' read -r name cdir <&3; do
    mkdir -p "$cdir" || die "$name: cannot create $cdir"
  done 3< <(jql -r 'include "lib"; accounts[] | [.name, .configDir] | @tsv' "$CONFIG")

  while IFS=$'\t' read -r name dir cdir <&3; do
    [ -d "$dir" ] || die "$name: $dir does not exist; create it, or run: claude-accounts set $name dirs- '$dir'"
    mise set --file "$dir/mise.local.toml" "CLAUDE_CONFIG_DIR=$cdir" >/dev/null || die "$name: mise set failed in $dir"
    mise trust --quiet "$dir/mise.local.toml" || die "$name: mise trust failed for $dir/mise.local.toml"
    echo "✔ $name: $dir uses $cdir"
  done 3< <(jql -r 'include "lib"; accounts[] | .name as $n | .configDir as $c | .dirs[] | [$n, ., $c] | @tsv' "$CONFIG")

  cleanup_stale

  while IFS=$'\t' read -r name cdir <&3; do
    if plugin_installed "$cdir"; then echo "✔ $name: account-badge installed"; continue; fi
    # Adding a marketplace that is already known fails harmlessly; the install below is what matters
    claude_as "$cdir" plugin marketplace add "$source" >/dev/null 2>&1 || true
    claude_as "$cdir" plugin install "$PLUGIN_ID" >/dev/null \
      || die "$name: could not install $PLUGIN_ID from $source (try: claude-accounts apply --marketplace <github owner/repo>)"
    echo "✔ $name: installed account-badge"
  done 3< <(jql -r 'include "lib"; accounts[] | [.name, .configDir] | @tsv' "$CONFIG")

  echo "Done. Sign in to any account that isn't yet: claude-accounts login <name>"
}

cmd_init() {
  if [ -f "$CONFIG" ]; then echo "Config already exists: $CONFIG"; return 0; fi
  mkdir -p "$CONFIG_DIR"
  jq -n '{default: "personal", accounts: {personal: {label: "PERSONAL", emoji: "🟢", configDir: "~/.claude"}}}' > "$CONFIG"
  echo "Created $CONFIG with the personal account (~/.claude)."
  echo "Next: claude-accounts add work --dir ~/path/to/work && claude-accounts apply"
}

cmd_add() {
  local name="${1:-}" dirs='[]' label='' emoji='' cdir='' p
  [ -n "$name" ] || die "usage: claude-accounts add <name> [--dir PATH]... [--label L] [--emoji E] [--config-dir D]"
  shift
  valid_name "$name"
  while [ $# -gt 0 ]; do
    case "$1" in
      --dir|--label|--emoji|--config-dir)
        [ $# -ge 2 ] || die "$1 needs a value"
        case "$1" in
          --dir) p="$(store_path "$2")"; dirs="$(jq -c --arg d "$p" '. + [$d]' <<<"$dirs")" ;;
          --label) label="$2" ;;
          --emoji) emoji="$2" ;;
          --config-dir) cdir="$(store_path "$2")" ;;
        esac
        shift 2 ;;
      *) die "unknown option: $1" ;;
    esac
  done
  load_config
  if account_exists "$name"; then die "account '$name' already exists"; fi
  update_config --arg n "$name" --argjson dirs "$dirs" --arg label "$label" --arg emoji "$emoji" --arg cdir "$cdir" '
    .accounts[$n] = ({dirs: $dirs}
      + (if $label != "" then {label: $label} else {} end)
      + (if $emoji != "" then {emoji: $emoji} else {} end)
      + (if $cdir != "" then {configDir: $cdir} else {} end))'
  echo "Added $name. Run 'claude-accounts apply' to set it up."
}

cmd_remove() {
  local name="${1:-}"
  [ -n "$name" ] || die "usage: claude-accounts remove <name>"
  load_config
  account_exists "$name" || die "no account '$name'"
  [ "$(jq -r .default "$CONFIG")" != "$name" ] || die "cannot remove the default account"
  update_config --arg n "$name" 'del(.accounts[$n])'
  if [ -f "$STATE" ]; then need mise; cleanup_stale; fi
  echo "Removed $name. Its config dir was kept."
}

cmd_set() {
  local name="${1:-}" field="${2:-}" value="${3:-}" path=""
  [ -n "$name" ] && [ -n "$field" ] && [ $# -ge 3 ] || die "usage: claude-accounts set <name> label|emoji|configDir|dirs+|dirs- <value>"
  load_config
  account_exists "$name" || die "no account '$name'"
  case "$field" in configDir|dirs+|dirs-) path="$(store_path "$value")" ;; esac
  case "$field" in
    label|emoji)
      update_config --arg n "$name" --arg f "$field" --arg v "$value" '.accounts[$n][$f] = $v' ;;
    configDir)
      update_config --arg n "$name" --arg v "$path" '.accounts[$n].configDir = $v' ;;
    dirs+)
      update_config --arg n "$name" --arg v "$path" '.accounts[$n].dirs = ((.accounts[$n].dirs // []) + [$v] | unique)' ;;
    dirs-)
      update_config --arg n "$name" --arg v "$path" 'include "lib";
        .accounts[$n].dirs = [ (.accounts[$n].dirs // [])[] | select(norm != ($v | norm)) ]' ;;
    *) die "unknown field '$field' (use label, emoji, configDir, dirs+ or dirs-)" ;;
  esac
  echo "Updated $name. Run 'claude-accounts apply' to put it into effect."
}

# version_ge A B: true when dotted version A >= B
version_ge() {
  awk -v a="$1" -v b="$2" 'BEGIN {
    split(a, x, "."); split(b, y, ".")
    for (i = 1; i <= 3; i++) { if (x[i] + 0 > y[i] + 0) exit 0; if (x[i] + 0 < y[i] + 0) exit 1 }
    exit 0 }'
}

cmd_which() {
  local json=false dir="" out cdir
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=true; shift ;;
      -*) die "unknown option: $1" ;;
      *) dir="$1"; shift ;;
    esac
  done
  if [ -n "$dir" ]; then
    [ -d "$dir" ] || die "$dir is not a directory"
    need mise
    # What a session started in DIR would get: mise's environment there, not this shell's
    # If mise can't load the dir (e.g. an untrusted config), a session there gets no CLAUDE_CONFIG_DIR
    cdir="$(mise env -C "$dir" --json 2>/dev/null | jq -r '.CLAUDE_CONFIG_DIR // empty')" || cdir=""
    if [ -n "$cdir" ]; then
      out="$(CLAUDE_CONFIG_DIR="$cdir" "$BASH" "$RESOLVE" --cwd "$dir")"
    else
      out="$(env -u CLAUDE_CONFIG_DIR "$BASH" "$RESOLVE" --cwd "$dir")"
    fi
  else
    out="$("$BASH" "$RESOLVE")"
  fi
  if [ "$json" = true ]; then printf '%s\n' "$out"; return 0; fi
  jq -r '.text,
    "  in use:   \(.account // "not in config") (\(.configDir))",
    "  expected: \(.expected // "-")"' <<<"$out"
}

cmd_login() {
  local name="${1:-}" cdir
  [ -n "$name" ] || die "usage: claude-accounts login <name>"
  need claude
  load_config
  account_exists "$name" || die "no account '$name'"
  cdir="$(jql -r --arg n "$name" 'include "lib"; accounts[] | select(.name == $n) | .configDir' "$CONFIG")"
  mkdir -p "$cdir"
  claude_as "$cdir" auth login
}

cmd_shell_init() {
  local shell="${1:-}" editor path
  case "$shell" in fish|bash|zsh) ;; *) die "usage: claude-accounts shell-init fish|bash|zsh" ;; esac
  if [ "$shell" = fish ]; then echo 'set -gx CLAUDE_ACCOUNTS_SHELL_INIT 1'; else echo 'export CLAUDE_ACCOUNTS_SHELL_INIT=1'; fi
  # One Zed process serves every window and keeps the environment it started with, so start it
  # without an account's CLAUDE_CONFIG_DIR; each project then gets its own from mise.
  for editor in $EDITORS; do
    path="$(command -v "$editor" 2>/dev/null)" || continue
    case "$path" in *"'"*) continue ;; esac
    if [ "$shell" = fish ]; then
      printf "function %s\n    env -u CLAUDE_CONFIG_DIR '%s' \$argv\nend\n" "$editor" "$path"
    else
      printf "%s() { env -u CLAUDE_CONFIG_DIR '%s' \"\$@\"; }\n" "$editor" "$path"
    fi
  done
}

zed_installed() {
  local editor
  for editor in $EDITORS; do command -v "$editor" >/dev/null 2>&1 && return 0; done
  return 1
}

DOCTOR_FAILED=0
ok() { printf '✔ %s\n' "$1"; }
bad() { printf '✘ %s\n    fix: %s\n' "$1" "$2"; DOCTOR_FAILED=1; }

cmd_doctor() {
  local t v problems name dir cdir got r
  for t in mise claude; do
    if command -v "$t" >/dev/null 2>&1; then ok "$t installed"; else bad "$t not installed" "install $t"; fi
  done
  if command -v claude >/dev/null 2>&1; then
    v="$(claude --version 2>/dev/null | awk '{print $1}')"
    if version_ge "$v" "$MIN_CLAUDE"; then ok "Claude Code $v"
    else bad "Claude Code $v is older than $MIN_CLAUDE" "update Claude Code, e.g. mise upgrade claude"; fi
  fi
  if [ -n "${MISE_SHELL:-}" ]; then ok "mise is activated in this shell"
  else bad "mise is not activated in this shell" "activate mise in your shell rc (https://mise.jdx.dev/getting-started.html)"; fi
  if zed_installed; then
    if [ -n "${CLAUDE_ACCOUNTS_SHELL_INIT:-}" ]; then ok "Zed wrapper active"
    else bad "Zed wrapper not active" "fish: claude-accounts shell-init fish | source; bash/zsh: eval \"\$(claude-accounts shell-init bash)\""; fi
  fi
  if [ ! -f "$CONFIG" ]; then bad "no config at $CONFIG" "claude-accounts init"; return 1; fi
  load_config
  problems="$(jql -r "$CHECK" "$CONFIG")"
  [ -z "$problems" ] || bad "config: $problems" "claude-accounts set / remove"

  if command -v mise >/dev/null 2>&1; then
    while IFS=$'\t' read -r name dir cdir <&3; do
      got="$(mise env -C "$dir" --json 2>/dev/null | jq -r '.CLAUDE_CONFIG_DIR // empty' 2>/dev/null || true)"
      if [ "$got" = "$cdir" ]; then ok "$name: $dir uses $cdir"
      elif [ -n "$got" ]; then bad "$name: $dir uses $got, not $cdir" "claude-accounts apply"
      else bad "$name: $dir uses the default (~/.claude), not $cdir" "claude-accounts apply"; fi
    done 3< <(jql -r 'include "lib"; accounts[] | .name as $n | .configDir as $c | .dirs[] | [$n, ., $c] | @tsv' "$CONFIG")
  fi

  while IFS=$'\t' read -r name cdir <&3; do
    if signed_in "$cdir"; then ok "$name: logged in"
    else bad "$name: not logged in" "claude-accounts login $name"; fi
    if command -v claude >/dev/null 2>&1 && plugin_installed "$cdir"; then ok "$name: account-badge installed"
    else bad "$name: account-badge not installed" "claude-accounts apply"; fi
  done 3< <(jql -r 'include "lib"; accounts[] | [.name, .configDir] | @tsv' "$CONFIG")

  r="$("$BASH" "$RESOLVE")"
  if jq -e '.mismatch or .error != null' >/dev/null <<<"$r"; then
    bad "$(jq -r .text <<<"$r") (current directory)" "open a new shell here so mise sets CLAUDE_CONFIG_DIR, then re-run doctor"
  else
    ok "current directory: $(jq -r .text <<<"$r")"
  fi
  return "$DOCTOR_FAILED"
}

# ---- setup: an interactive walk through init, add, apply, login and the shell rc ----

NO_ANSWER="no answer (setup asks its questions on the terminal)"

# ask VAR PROMPT [DEFAULT]: one answer, or DEFAULT when it is left empty. On a terminal this uses
# readline, so answers can be edited and paths completed with Tab.
ask() {
  local a prompt="$2: "
  [ -z "${3:-}" ] || prompt="$2 [$3]: "
  if [ -t 0 ]; then
    IFS= read -e -r -p "$prompt" a || { echo; die "$NO_ANSWER"; }
  else
    printf '%s' "$prompt"
    IFS= read -r a || { echo; die "$NO_ANSWER"; }
  fi
  printf -v "$1" '%s' "${a:-${3:-}}"
}

# confirm PROMPT y|n: yes or no, with the given default
confirm() {
  local a hint="[Y/n]"
  [ "$2" = y ] || hint="[y/N]"
  while :; do
    printf '%s %s: ' "$1" "$hint"
    IFS= read -r a || { echo; die "$NO_ANSWER"; }
    case "${a:-$2}" in [Yy]|[Yy][Ee][Ss]) return 0 ;; [Nn]|[Nn][Oo]) return 1 ;; esac
    echo "  Please answer y or n."
  done
}

# fails CMD...: run a check in a subshell; on failure print its message and succeed
fails() {
  local msg
  if msg="$( ("$@") 2>&1)"; then return 1; fi
  printf '  ✘ %s\n' "${msg#claude-accounts: }"
}

# draft_with JQ-ARGS... FILTER: the draft config with FILTER applied, or fail printing its problems
draft_with() {
  local next problems
  next="$(jql -c "$@" <<<"$DRAFT")" || return 1
  problems="$(jql -r "$CHECK" <<<"$next")"
  if [ -n "$problems" ]; then printf '  ✘ %s\n' "$problems" >&2; return 1; fi
  printf '%s' "$next"
}

# tilde PATH: PATH with $HOME shown as ~
# shellcheck disable=SC2088  # the literal ~ is what gets shown
tilde() { case "$1" in "$HOME"/*) printf '~/%s' "${1#"$HOME"/}" ;; *) printf '%s' "$1" ;; esac; }

upper() { printf '%s' "$1" | tr '[:lower:]' '[:upper:]'; }

# The first of these emoji no account in the draft uses yet
next_emoji() {
  local e
  for e in 🔴 🔵 🟣 🟠 🟡 🟤 ⚪; do
    jq -e --arg e "$e" 'any(.accounts[]; .emoji == $e)' <<<"$DRAFT" >/dev/null || { printf '%s' "$e"; return; }
  done
  printf '%s' 🔵
}

# setup_account DEFAULT-NAME IS-DEFAULT: ask for one account and add it to the draft
setup_account() {
  local name label emoji suggest cdir dir path next ndirs=0
  while :; do
    ask name "  Account name" "$1"
    if [ -z "$name" ]; then echo "  ✘ the account needs a name"; continue; fi
    fails valid_name "$name" && continue
    if jq -e --arg n "$name" '.accounts | has($n)' <<<"$DRAFT" >/dev/null; then
      echo "  ✘ there is already an account called $name"; continue
    fi
    break
  done
  [ "$2" = false ] || DRAFT="$(jq -c --arg n "$name" '.default = $n' <<<"$DRAFT")"
  ask label "  Label" "$(upper "$name")"
  if [ "$2" = true ]; then ask emoji "  Emoji" 🟢; else ask emoji "  Emoji" "$(next_emoji)"; fi
  # shellcheck disable=SC2088  # shown to the user as typed
  if [ "$2" = true ]; then suggest="~/.claude"; else suggest="~/.claude-$name"; fi
  while :; do
    ask cdir "  Claude config dir" "$suggest"
    fails store_path "$cdir" && continue
    path="$(store_path "$cdir")"
    next="$(draft_with --arg n "$name" --arg l "$label" --arg e "$emoji" --arg c "$path" \
      '.accounts[$n] = {label: $l, emoji: $e, configDir: $c}' 2>&1)" || { printf '%s\n' "$next"; continue; }
    DRAFT="$next"
    break
  done
  [ "$2" = false ] || return 0

  echo "  Which directories belong to $name? Claude Code uses $name anywhere under them."
  while :; do
    if [ "$ndirs" -eq 0 ]; then ask dir "  Directory (Tab completes)" ""
    else ask dir "  Another directory? (Enter to finish)" ""; fi
    if [ -z "$dir" ]; then
      [ "$ndirs" -gt 0 ] && break
      echo "  ✘ $name needs at least one directory"; continue
    fi
    path="$(expand_path "$dir")"
    if [ ! -d "$path" ]; then
      confirm "  $dir doesn't exist. Create it?" y || continue
      mkdir -p "$path" || { echo "  ✘ could not create $dir"; continue; }
    fi
    fails store_path "$dir" && continue
    path="$(store_path "$dir")"
    if jq -e --arg n "$name" --arg d "$path" '.accounts[$n].dirs // [] | index($d)' <<<"$DRAFT" >/dev/null; then
      echo "  ✘ $path is already added"; continue
    fi
    next="$(draft_with --arg n "$name" --arg d "$path" '.accounts[$n].dirs = ((.accounts[$n].dirs // []) + [$d])' 2>&1)" \
      || { printf '%s\n' "$next"; continue; }
    DRAFT="$next"
    ndirs=$((ndirs + 1))
    echo "  ✔ added $path"
  done
}

show_accounts() {
  jq -r '.default as $d | .accounts | to_entries[]
    | "  \(.value.emoji // "🔵") \(.value.label // (.key | ascii_upcase))  (\(.key))  \(.value.configDir // "")"
      + (if .key == $d then "  default: used everywhere else" else "  for " + ((.value.dirs // []) | join(", ")) end)' <<<"$1"
}

# Comment written above the shell-init line, so uninstall can find what setup added
RC_COMMENT="# Start Zed without an account's CLAUDE_CONFIG_DIR (claude-accounts)"

# add_shell_rc: when Zed is installed, add the shell-init line to the user's shell rc, once
add_shell_rc() {
  local shell rc line shown
  zed_installed || return 0
  shell="$(basename "${SHELL:-}")"
  case "$shell" in
    fish) rc="${XDG_CONFIG_HOME:-$HOME/.config}/fish/config.fish"; line='claude-accounts shell-init fish | source' ;;
    bash) rc="$HOME/.bashrc"; line='eval "$(claude-accounts shell-init bash)"' ;;
    zsh) rc="${ZDOTDIR:-$HOME}/.zshrc"; line='eval "$(claude-accounts shell-init zsh)"' ;;
    *) echo "Zed is installed: add the Zed wrapper to your shell rc (see claude-accounts shell-init)"; return 0 ;;
  esac
  shown="$(tilde "$rc")"
  if grep -q 'claude-accounts shell-init' "$rc" 2>/dev/null; then
    echo "✔ $shown already loads the Zed wrapper"; return 0
  fi
  mkdir -p "$(dirname "$rc")"
  printf '\n%s\n%s\n' "$RC_COMMENT" "$line" >> "$rc"
  echo "✔ Zed is installed: added the Zed wrapper to $shown"
}

cmd_setup() {
  local choice fresh=true name cdir more=y
  need mise claude
  DRAFT='{"default":"","accounts":{}}'
  echo "Set up claude-accounts: one Claude Code account per set of directories."
  echo "Press Enter to accept the [default]."
  echo
  if [ -f "$CONFIG" ] && jq -e . "$CONFIG" >/dev/null 2>&1; then
    echo "You already have these accounts ($CONFIG):"
    show_accounts "$(cat "$CONFIG")"
    while :; do
      ask choice "(a)dd accounts, (s)tart over, or (q)uit" a
      case "$choice" in
        a|add) DRAFT="$(jq -c . "$CONFIG")"; fresh=false; break ;;
        s|start*) break ;;
        q|quit) return 0 ;;
        *) echo "  Please answer a, s or q." ;;
      esac
    done
    echo
  fi
  if [ "$fresh" = true ]; then
    echo "Your default account is used everywhere no other account claims."
    setup_account personal true
    echo
  fi
  while :; do
    [ "$(jq '.accounts | length' <<<"$DRAFT")" -gt 1 ] && more=n
    confirm "Add another account?" "$more" || break
    if jq -e '.accounts | has("work")' <<<"$DRAFT" >/dev/null; then name=""; else name=work; fi
    setup_account "$name" false
    echo
  done

  echo "Your accounts:"
  show_accounts "$DRAFT"
  echo
  confirm "Save this and set it up?" y || die "nothing saved"
  mkdir -p "$CONFIG_DIR"
  if [ "$fresh" = true ] && [ -f "$CONFIG" ]; then cp "$CONFIG" "$CONFIG.bak" && echo "Saved the old config to $CONFIG.bak"; fi
  jq . <<<"$DRAFT" > "$CONFIG.tmp" && mv "$CONFIG.tmp" "$CONFIG"
  echo "✔ saved $(tilde "$CONFIG")"
  cmd_apply >/dev/null
  echo "✔ applied: mise env for each directory, account-badge in each account"
  echo

  while IFS=$'\t' read -r name cdir <&3; do
    signed_in "$cdir" && { echo "✔ $name: signed in"; continue; }
    if confirm "Sign in to $name now?" y; then
      mkdir -p "$cdir"
      claude_as "$cdir" auth login
    else
      echo "  Later: claude-accounts login $name"
    fi
  done 3< <(jql -r 'include "lib"; accounts[] | [.name, .configDir] | @tsv' "$CONFIG")
  echo

  add_shell_rc
  echo
  echo "Done. Open a new shell so that mise loads the new setup. Then check everything with: claude-accounts doctor"
}

# ---- uninstall: undo what setup and apply did ----

# rc_files: the shell rc files that load the Zed wrapper
rc_files() {
  local rc
  for rc in "${XDG_CONFIG_HOME:-$HOME/.config}/fish/config.fish" "$HOME/.bashrc" "${ZDOTDIR:-$HOME}/.zshrc"; do
    if grep -q 'claude-accounts shell-init' "$rc" 2>/dev/null; then printf '%s\n' "$rc"; fi
  done
}

# strip_rc FILE: remove the shell-init lines and the comment setup wrote above them (with the blank
# line before it). Writes in place, so a symlinked rc (for example from a dotfiles repo) stays a link.
strip_rc() {
  local tmp="$1.claude-accounts.tmp"
  awk -v c="$RC_COMMENT" '
    $0 == "" { if (held) print ""; held = 1; next }
    $0 == c { held = 0; next }
    index($0, "claude-accounts shell-init") { next }
    { if (held) { print ""; held = 0 } print }
    END { if (held) print "" }' "$1" > "$tmp" || { rm -f "$tmp"; die "could not edit $1"; }
  cat "$tmp" > "$1"
  rm -f "$tmp"
}

# each PREFIX LINES: print PREFIX and each non-empty line (a path) with ~ for $HOME
each() {
  local line
  while IFS= read -r line; do [ -z "$line" ] || echo "$1 $(tilde "$line")"; done <<<"$2"
}

cmd_uninstall() {
  local yes=false dirs cdirs rcs dir cdir rc
  case "${1:-}" in
    --yes|-y) yes=true ;;
    '') ;;
    *) die "usage: claude-accounts uninstall [--yes]" ;;
  esac
  need mise claude

  # Directories with our env: those an earlier apply recorded, and those the config lists now
  dirs="$( { jq -r '(.managedDirs // [])[]' "$STATE" 2>/dev/null || true
             jql -r 'include "lib"; accounts[] | .dirs[]' "$CONFIG" 2>/dev/null || true; } | sort -u)"
  cdirs="$( { printf '%s\n' "$HOME/.claude"
              jql -r 'include "lib"; accounts[] | .configDir' "$CONFIG" 2>/dev/null || true; } | sort -u)"
  rcs="$(rc_files)"

  echo "This removes:"
  each "  - CLAUDE_CONFIG_DIR from mise.local.toml in" "$dirs"
  each "  - the account-badge plugin from" "$cdirs"
  each "  - the Zed wrapper from" "$rcs"
  echo "  - the configuration in $(tilde "$CONFIG_DIR")"
  echo "It keeps your Claude config directories, with your logins and history."
  echo
  if [ "$yes" = false ]; then confirm "Uninstall claude-accounts?" n || die "nothing changed"; fi

  while IFS= read -r dir <&3; do
    [ -n "$dir" ] && [ -f "$dir/mise.local.toml" ] || continue
    mise unset --file "$dir/mise.local.toml" CLAUDE_CONFIG_DIR >/dev/null || die "mise unset failed in $dir"
    echo "✔ $(tilde "$dir") no longer sets CLAUDE_CONFIG_DIR"
  done 3<<<"$dirs"

  while IFS= read -r cdir <&3; do
    [ -d "$cdir" ] || continue
    if plugin_installed "$cdir"; then
      claude_as "$cdir" plugin uninstall "$PLUGIN_ID" >/dev/null || die "could not uninstall $PLUGIN_ID from $cdir"
      echo "✔ removed account-badge from $(tilde "$cdir")"
    fi
    claude_as "$cdir" plugin marketplace remove account-switcher >/dev/null 2>&1 || true
  done 3<<<"$cdirs"

  while IFS= read -r rc <&3; do
    [ -n "$rc" ] || continue
    strip_rc "$rc"
    echo "✔ removed the Zed wrapper from $(tilde "$rc")"
  done 3<<<"$rcs"

  rm -rf "$CONFIG_DIR"
  echo "✔ removed $(tilde "$CONFIG_DIR")"
  echo
  echo "Kept your Claude config directories:"
  while IFS= read -r cdir; do [ -d "$cdir" ] && echo "  $(tilde "$cdir")"; done <<<"$cdirs"
  echo
  echo "To remove the claude-accounts command too, run one of these:"
  echo "  mise unuse -g npm:@zdavison/claude-accounts"
  echo "  npm uninstall -g @zdavison/claude-accounts"
  [ ! -e "$ROOT/.git" ] || echo "  or delete the clone at $(tilde "$ROOT")"
}

usage() {
  cat <<'EOF'
Usage: claude-accounts <command>

  setup                        walk through choosing and setting up your accounts
  init                         create the config with a personal account (~/.claude), no questions
  add <name> [--dir PATH]...   add an account; options: --label, --emoji, --config-dir
  remove <name>                remove an account (its config dir is kept)
  set <name> <field> <value>   field: label, emoji, configDir, dirs+ (add a dir), dirs- (remove one)
  apply [--marketplace SRC]    set up mise env, config dirs and the account-badge plugin
  which [DIR] [--json]         show the account in use here (or in DIR) and the one expected
  login <name>                 sign in to an account
  shell-init fish|bash|zsh     print the Zed wrapper for your shell rc
  doctor                       check the setup and say how to fix problems
  uninstall [--yes]            undo setup and apply (keeps your Claude config directories)
EOF
}

main() {
  need jq
  local cmd="${1:-help}"
  [ $# -eq 0 ] || shift
  case "$cmd" in
    setup) cmd_setup "$@" ;;
    init) cmd_init "$@" ;;
    add) cmd_add "$@" ;;
    remove) cmd_remove "$@" ;;
    set) cmd_set "$@" ;;
    apply) cmd_apply "$@" ;;
    which) cmd_which "$@" ;;
    login) cmd_login "$@" ;;
    shell-init) cmd_shell_init "$@" ;;
    doctor) cmd_doctor "$@" ;;
    uninstall) cmd_uninstall "$@" ;;
    help|-h|--help) usage ;;
    *) usage >&2; exit 1 ;;
  esac
}

main "$@"
